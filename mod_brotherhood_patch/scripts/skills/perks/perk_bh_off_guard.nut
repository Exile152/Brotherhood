this.perk_bh_off_guard <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_off_guard";this.m.Name="Off Guard";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.overwhelm","ui/perks/perk_42.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function hasActed(_target){return _target!=null&&(_target.isTurnDone()||_target.isWaitActionSpent());}function onAnySkillUsed(_skill,_target,_properties){if(_skill!=null&&_skill.isAttack()&&this.hasActed(_target)){_properties.MeleeSkill+=10;_properties.RangedSkill+=10;::Brotherhood.logArchetypeTest("OFF GUARD",this.getContainer().getActor(),"Applied +10% hit chance against "+_target.getName()+" because they already acted this round.");}}function onGetHitFactors(_skill,_targetTile,_tooltip){if(_targetTile.IsOccupiedByActor&&this.hasActed(_targetTile.getEntity()))_tooltip.push({icon="ui/tooltips/positive.png",text=::MSU.Text.colorPositive("+10% ")+this.getName()});}});
