this.perk_bh_shatter <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_shatter";this.m.Name="Shatter";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.head_hunter","ui/perks/perk_15.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_p){_p.DamageAgainstMult[this.Const.BodyPart.Head]+=0.10;}function onTargetHit(_s,_t,_part,_hp,_armor){if(_part==this.Const.BodyPart.Head)::Brotherhood.logLatestObsidianTest("SHATTER",this.getContainer().getActor(),"Applied +10% head-hit damage to "+(_t==null?"unknown target":_t.getName())+".");}});
