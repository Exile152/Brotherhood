this.perk_bh_knowledge_mastery <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_knowledge_mastery";this.m.Name="Knowledge Mastery";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.bags_and_belts","ui/perks/perk_20.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}});
