this.perk_bh_gunpowder_mastery <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_gunpowder_mastery";this.m.Name="Gunpowder Mastery";this.m.Description=::Brotherhood.getArtilleristTooltip(this.m.ID);this.m.Icon="ui/perks/bh_gunpowder_mastery.png";this.m.IconDisabled="ui/perks/bh_gunpowder_mastery_sw.png";this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}});
