this.perk_bh_unmovable <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_unmovable";this.m.Name="Unmovable";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.steel_brow","ui/perks/perk_09.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_p){_p.IsImmuneToKnockBackAndGrab=true;_p.IsImmuneToRotation=true;}function onCombatStarted(){::Brotherhood.logLatestObsidianTest("UNMOVABLE",this.getContainer().getActor(),"Enabled knockback, grab, and hostile rotation immunity.");}});
