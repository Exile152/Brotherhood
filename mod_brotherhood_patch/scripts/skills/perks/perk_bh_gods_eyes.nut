this.perk_bh_gods_eyes <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_gods_eyes";this.m.Name="God's Eyes";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.anticipation","ui/perks/perk_10.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_properties){local points=::Math.max(0,_properties.getVision()-7);_properties.MeleeDefense+=points*7;_properties.RangedDefense+=points*7;}});
