this.perk_bh_sonata <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_sonata";this.m.Name="Sonata";this.m.Description=::Brotherhood.getObsidianArchetypeTooltip(this.m.ID);this.m.Icon="ui/perks/perk_28.png";::Brotherhood.applyCustomPerkIcon(this);this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;}function onAdded(){if(!this.getContainer().hasSkill("actives.bh_sonata"))this.getContainer().add(this.new("scripts/skills/actives/bh_sonata_skill"));}function onRemoved(){this.getContainer().removeByID("actives.bh_sonata");}});
