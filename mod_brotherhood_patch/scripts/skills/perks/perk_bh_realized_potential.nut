this.perk_bh_realized_potential <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_realized_potential";this.m.Name="Realized Potential";this.m.Description="Your salary is doubled, all attributes are increased by 15, and you gain one Perk Point.";this.m.Icon="ui/perks/perk_rf_discovered_talent.png";this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;this.m.IsRefundable=false;}function onAdded(){if(!this.m.IsNew)return;local a=this.getContainer().getActor();local b=a.getBaseProperties();b.DailyWageMult*=2.0;b.MeleeSkill+=15;b.MeleeDefense+=15;b.RangedSkill+=15;b.RangedDefense+=15;b.Hitpoints+=15;b.Stamina+=15;b.Initiative+=15;b.Bravery+=15;if("PerkPoints" in a.m)a.m.PerkPoints++;a.setDirty(true);}});
