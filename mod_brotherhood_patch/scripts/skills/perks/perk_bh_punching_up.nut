this.perk_bh_punching_up <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_punching_up";this.m.Name="Punching Up";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.executioner","ui/perks/perk_16.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onAnySkillUsed(_skill,_target,_properties){if(_skill!=null&&_skill.isAttack()&&_target!=null&&_target.getHitpoints()>this.getContainer().getActor().getHitpoints()){_properties.DamageTotalMult*=1.15;::Brotherhood.logArchetypeTest("PUNCHING UP",this.getContainer().getActor(),"Applied +15% damage against "+_target.getName()+" ("+_target.getHitpoints()+" HP vs "+this.getContainer().getActor().getHitpoints()+" HP).");}}});
