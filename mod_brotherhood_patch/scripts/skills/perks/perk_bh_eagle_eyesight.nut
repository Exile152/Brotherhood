this.perk_bh_eagle_eyesight <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_eagle_eyesight";this.m.Name="Eagle Eyesight";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.anticipation","ui/perks/perk_10.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_properties){_properties.Vision+=1;}function onAnySkillUsed(_skill,_target,_properties){if(_target==null||(!::Brotherhood.isWeaponSkillType(_skill,this.Const.Items.WeaponType.Bow)&&!::Brotherhood.isWeaponSkillType(_skill,this.Const.Items.WeaponType.Crossbow)))return;local actor=this.getContainer().getActor();local distance=actor.getTile().getDistanceTo(_target.getTile());if(distance<3)return;local excess=::Math.max(0,actor.getCurrentProperties().getVision()-distance);local pct=::Math.min(25,excess*5);if(pct<=0)return;_properties.DamageArmorMult*=1.0+pct*0.01;::Brotherhood.logArchetypeTest("EAGLE EYESIGHT",actor,"Applied +"+pct+"% armor damage at distance "+distance+" with Vision "+actor.getCurrentProperties().getVision()+".");}});
