this.perk_bh_help <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_help";this.m.Name="Help";this.m.Description=::Brotherhood.getObsidianArchetypeTooltip(this.m.ID);this.m.Icon="ui/perks/perk_45.png";::Brotherhood.applyCustomPerkIcon(this);this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;}function onAdded(){if(!this.getContainer().hasSkill("actives.bh_help"))this.getContainer().add(this.new("scripts/skills/actives/bh_help_skill"));}function onRemoved(){this.getContainer().removeByID("actives.bh_help");}});
