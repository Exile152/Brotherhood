this.perk_bh_relentless <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_relentless";this.m.Name="Relentless";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.relentless","ui/perks/perk_26.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_properties){_properties.FatigueToInitiativeRate*=0.5;_properties.InitiativeAfterWaitMult=1.0;}});
