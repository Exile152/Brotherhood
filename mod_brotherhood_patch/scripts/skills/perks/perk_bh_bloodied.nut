this.perk_bh_bloodied <- this.inherit("scripts/skills/skill", {m={LastRound=0},function create(){this.m.ID="perk.bh_bloodied";this.m.Name="Bloodied";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.battle_flow","ui/perks/perk_35.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function tryRecover(_reason){local round=this.Time.getRound();if(this.m.LastRound==round)return false;this.m.LastRound=round;local actor=this.getContainer().getActor();local old=actor.getFatigue();actor.setFatigue(::Math.max(0,old-5));actor.setDirty(true);::Brotherhood.logArchetypeTest("BLOODIED",actor,"Recovered "+(old-actor.getFatigue())+" Fatigue because "+_reason+".");return true;}function onDamageReceived(_attacker,_damageHP,_damageArmor){if(_damageHP>0)this.tryRecover("this character took Hitpoint damage");}function onCombatStarted(){this.m.LastRound=0;}function onCombatFinished(){this.m.LastRound=0;this.skill.onCombatFinished();}});
