this.perk_bh_forsworn <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_forsworn";this.m.Name="Forsworn";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.lone_wolf","ui/perks/perk_61.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}});
