this.perk_bh_steady_hands <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_steady_hands";this.m.Name="Steady Hands";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.bullseye","ui/perks/perk_17.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}});
