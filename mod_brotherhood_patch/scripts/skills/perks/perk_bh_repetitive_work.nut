this.perk_bh_repetitive_work <- this.inherit("scripts/skills/skill", {m={Used=[]},function create(){this.m.ID="perk.bh_repetitive_work";this.m.Name="Repetitive Work";this.m.Description=::Brotherhood.getBruteLaborerTooltip(this.m.ID);this.m.Icon="ui/perks/perk_39.png";this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_p){_p.Stamina+=::Math.floor(this.getContainer().getActor().getBaseProperties().Stamina*0.10);}function wasUsed(_id){return this.m.Used.find(_id)!=null;}function recordUse(_id,_repeat){if(!this.wasUsed(_id))this.m.Used.push(_id);if(_repeat)::Brotherhood.logArchetypeTest("REPETITIVE WORK",this.getContainer().getActor(),"Applied -25% Fatigue to repeated use of "+_id+".");}function onTurnStart(){this.m.Used.clear();}});
