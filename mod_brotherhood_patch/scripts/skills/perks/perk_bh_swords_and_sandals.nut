this.perk_bh_swords_and_sandals <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_swords_and_sandals";this.m.Name="Swords and Sandals";this.m.Description=::Brotherhood.getObsidianArchetypeTooltip(this.m.ID);this.m.Icon="ui/perks/perk_28.png";this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;}function onAdded(){if(!this.getContainer().hasSkill("actives.bh_swords_and_sandals"))this.getContainer().add(this.new("scripts/skills/actives/bh_swords_and_sandals_skill"));}function onRemoved(){this.getContainer().removeByID("actives.bh_swords_and_sandals");}});
