this.perk_bh_big_bones <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_big_bones";this.m.Name="Big Bones";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.steel_brow","ui/perks/perk_09.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}});
