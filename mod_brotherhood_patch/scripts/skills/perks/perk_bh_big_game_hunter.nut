this.perk_bh_big_game_hunter <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_big_game_hunter";this.m.Name="Big Game Hunter";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.head_hunter","ui/perks/perk_15.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onAnySkillUsed(_skill,_target,_p){if(_skill==null||!_skill.isAttack()||!_skill.isRanged()||_target==null)return;local owner=this.getContainer().getActor();local ratio=_target.getHitpointsMax().tofloat()/::Math.maxf(1.0,owner.getHitpointsMax().tofloat());if(ratio<=1.0)return;local bonus=::Math.minf(0.25,(ratio-1.0)*0.20);_p.DamageTotalMult*=1.0+bonus;::Brotherhood.logLatestObsidianTest("BIG GAME HUNTER",owner,"Applied +"+::Math.round(bonus*100)+"% damage against "+_target.getName()+" (max HP ratio "+ratio+").");}});
