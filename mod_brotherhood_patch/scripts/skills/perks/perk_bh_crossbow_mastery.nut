this.perk_bh_crossbow_mastery <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_crossbow_mastery";this.m.Name="Crossbow Mastery";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.mastery.crossbow","ui/perks/perk_10.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_properties){_properties.IsSpecializedInCrossbows=true;}function onAnySkillUsed(_skill,_target,_properties){if(::Brotherhood.isWeaponSkillType(_skill,this.Const.Items.WeaponType.Crossbow)){_properties.DamageDirectAdd+=0.20;::Brotherhood.logArchetypeTest("CROSSBOW MASTERY",this.getContainer().getActor(),"Applied +20% armor penetration to "+_skill.getName()+".");}}});
