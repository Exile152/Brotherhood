this.perk_bh_bloodletting <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_bloodletting";this.m.Name="Bloodletting";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.hold_out","ui/perks/perk_04.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onAdded(){if(!this.getContainer().hasSkill("actives.bh_bloodletting"))this.getContainer().add(this.new("scripts/skills/actives/bh_bloodletting_skill"));}function onRemoved(){this.getContainer().removeByID("actives.bh_bloodletting");}});
