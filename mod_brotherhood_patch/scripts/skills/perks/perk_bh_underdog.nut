this.perk_bh_underdog <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_underdog";this.m.Name="Underdog";this.m.Description=::Brotherhood.getExpansionArchetypeTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.underdog","ui/perks/perk_60.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_properties){_properties.SurroundedDefense+=5;}});
