this.perk_bh_small_head <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_small_head";this.m.Name="Small Head";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.head_hunter","ui/perks/perk_15.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_p){_p.HitChance[this.Const.BodyPart.Head]+=10;}function onCombatStarted(){::Brotherhood.logLatestObsidianTest("SMALL HEAD",this.getContainer().getActor(),"Applied +10% chance to hit the head.");}});
