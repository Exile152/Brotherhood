this.perk_bh_fruits_of_labor <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_fruits_of_labor";this.m.Name="Fruits of Labor";this.m.Description=::Brotherhood.getBruteLaborerTooltip(this.m.ID);this.m.Icon="ui/perks/perk_rf_fruits_of_labor.png";this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_p){_p.HitpointsMult*=1.10;_p.StaminaMult*=1.10;}});
