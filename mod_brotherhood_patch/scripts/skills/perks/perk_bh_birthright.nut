this.perk_bh_birthright <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_birthright";this.m.Name="Birthright";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.gifted","ui/perks/perk_56.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onCombatStarted(){::Brotherhood.logLatestObsidianTest("BIRTHRIGHT",this.getContainer().getActor(),"Trait numerical deltas are being applied a second time.");}});
