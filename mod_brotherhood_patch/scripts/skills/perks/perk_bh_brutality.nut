this.perk_bh_brutality <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_brutality";this.m.Name="Brutality";this.m.Description=::Brotherhood.getBruteLaborerTooltip(this.m.ID);this.m.Icon="ui/perks/bh_brutality.png";this.m.IconDisabled="ui/perks/bh_brutality_sw.png";this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onTargetHit(_s,_t,_part,_hp,_armor){if(_t!=null&&_s!=null&&_s.isAttack()&&!_s.isRanged()&&_armor>0&&_t.getArmor(_part)<=0){_t.getSkills().add(this.new("scripts/skills/effects/staggered_effect"));::Brotherhood.logArchetypeTest("BRUTALITY",this.getContainer().getActor(),"Destroyed armor and Staggered "+_t.getName()+".");}}});
