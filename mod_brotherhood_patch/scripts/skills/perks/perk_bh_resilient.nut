this.perk_bh_resilient <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="perk.bh_resilient";this.m.Name="Resilient";this.m.Description=::Brotherhood.getLatestObsidianTooltip(this.m.ID);::Brotherhood.applySourcePerkIcon(this,"perk.hold_out","ui/perks/perk_04.png");this.m.Type=this.Const.SkillType.Perk;this.m.Order=this.Const.SkillOrder.Perk;this.m.IsActive=false;}function onUpdate(_p){_p.NegativeStatusEffectDuration-=5;if("RF_BleedingEffectMult" in _p)_p.RF_BleedingEffectMult*=0.5;}function onCombatStarted(){::Brotherhood.logLatestObsidianTest("RESILIENT",this.getContainer().getActor(),"Enabled one-turn negative statuses and halved numerical injury penalties.");}});
