this.bh_duck_redirect_effect <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="effects.bh_duck_redirect";this.m.Name="Redirected by Duck!";this.m.Type=this.Const.SkillType.StatusEffect;this.m.IsActive=false;this.m.IsHidden=true;this.m.IsRemovedAfterBattle=true;}function onAnySkillUsed(_skill,_target,_p){if(_skill!=null&&_skill.isAttack()){_p.MeleeSkill+=1000;_p.RangedSkill+=1000;_p.DamageTotalMult*=0.50;}}});
