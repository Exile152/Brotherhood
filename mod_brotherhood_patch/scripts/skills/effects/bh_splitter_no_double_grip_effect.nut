this.bh_splitter_no_double_grip_effect <- this.inherit("scripts/skills/skill", {m={Turns=1},function create(){this.m.ID="effects.bh_splitter_no_double_grip";this.m.Name="Denied Double Grip";this.m.Description="You cannot benefit from Double Grip.";this.m.Icon="ui/perks/perk_21.png";this.m.Type=this.Const.SkillType.StatusEffect;this.m.IsActive=false;this.m.IsRemovedAfterBattle=true;}function setTurns(_n){this.m.Turns=_n;}function onTurnEnd(){--this.m.Turns;if(this.m.Turns<=0)this.removeSelf();}});
