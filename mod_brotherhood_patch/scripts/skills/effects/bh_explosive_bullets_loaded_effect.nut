this.bh_explosive_bullets_loaded_effect <- this.inherit("scripts/skills/skill", {m={},function create(){this.m.ID="effects.bh_explosive_bullets_loaded";this.m.Name="Explosive Bullets Loaded";this.m.Description="Your next Handgonne shot deals +60% armor damage and ignores an additional 20% of armor.";this.m.Icon="ui/perks/perk_15.png";this.m.Type=this.Const.SkillType.StatusEffect;this.m.IsActive=false;this.m.IsRemovedAfterBattle=true;}});
