this.pg_bh_wildling <- ::inherit(::DynamicPerks.Class.PerkGroup, {m={},function create(){this.m.ID="pg.bh_wildling";this.m.Name="Wildling";this.m.Description="A self-reliant wilderness fighter who adapts, travels, and hunts alone.";this.m.Icon="ui/perk_groups/rf_unstoppable.png";this.m.Tree=[["perk.bh_fast_adaptation","perk.pathfinder"],[],[],["perk.bh_throwing_mastery"],["perk.lone_wolf"],[],[]];}});
