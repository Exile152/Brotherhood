this.pg_bh_braggart <- ::inherit(::DynamicPerks.Class.PerkGroup, {m={},function create(){this.m.ID="pg.bh_braggart";this.m.Name="Braggart";this.m.Description="A boastful challenger who intimidates lesser foes, picks fights, and claims every victory as his own.";this.m.Icon="ui/perk_groups/rf_vicious.png";this.m.Tree=[[],["perk.bh_could_not_care_less"],["perk.bh_duel_coward"],[],["perk.bh_punching_up"],[],["perk.bh_winner_takes_all"]];}});
