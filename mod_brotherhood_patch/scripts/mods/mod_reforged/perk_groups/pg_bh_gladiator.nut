this.pg_bh_gladiator <- ::inherit(::DynamicPerks.Class.PerkGroup, {m={},function create(){this.m.ID="pg.bh_gladiator";this.m.Name="Gladiator";this.m.Description="A pit fighter who thrives while bloodied, surrounded, and performing for a hostile crowd.";this.m.Icon="ui/perk_groups/rf_unstoppable.png";this.m.Tree=[[],["perk.bh_bloodied"],["perk.bh_relentless"],["perk.bh_throwing_mastery","perk.bh_net_mastery"],["perk.bh_underdog"],["perk.bh_all_eyes_on_me"],[]];}});
