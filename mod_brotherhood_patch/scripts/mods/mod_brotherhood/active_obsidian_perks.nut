::Brotherhood.ActiveObsidianPerkIDs <- {};
foreach (entry in ::Brotherhood.ActiveObsidianPerks)
{
	::Brotherhood.ActiveObsidianPerkIDs[entry.ID] <- entry.Note;
}

::Brotherhood.isActiveObsidianPerk <- function( _perkID )
{
	return typeof _perkID == "string" && _perkID in ::Brotherhood.ActiveObsidianPerkIDs;
}

::Brotherhood.addActiveObsidianPerk <- function( _perkTree, _perkID, _tier, _source )
{
	if (!::Brotherhood.isActiveObsidianPerk(_perkID))
	{
		::logWarning("[Brotherhood][OBSIDIAN PERK FILTER] Skipped inactive perk " + _perkID + " from " + _source + "; it has no current non-old Obsidian perk note.");
		return false;
	}
	_perkTree.addPerk(_perkID, _tier);
	local added = _perkTree.hasPerk(_perkID);
	::Brotherhood.fleshcraftLogInfo("[Brotherhood][FLESHCRAFT][TREE ADD] perk=" + _perkID + "; tier=" + _tier + "; source=" + _source + "; added=" + added.tostring());
	return added;
}
