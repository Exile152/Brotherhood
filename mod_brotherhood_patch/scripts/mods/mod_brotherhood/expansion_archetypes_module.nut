::Brotherhood.getCustomPerkIcons <- function( _id )
{
	return _id in ::Brotherhood.CustomPerkIcons ? ::Brotherhood.CustomPerkIcons[_id] : null;
}

::Brotherhood.applyCustomPerkIcon <- function( _skill )
{
	local icons = ::Brotherhood.getCustomPerkIcons(_skill.m.ID);
	if (icons == null) return false;
	_skill.m.Icon = icons[0];
	_skill.m.IconDisabled = icons[1];
	return true;
}

::Brotherhood.getExpansionArchetypeTooltip <- function( _id )
{
	local data = {
		"perk.bh_could_not_care_less": ["Get out of my way, you don't matter.", ["As long as you have not hit them, enemies with lower current Melee Attack than you suffer " + ::MSU.Text.colorPositive("-20%") + " chance to hit you."]],
		"perk.bh_duel_coward": ["Bet you can't.", ["Unlocks the Duel skill, which allows you to taunt an enemy into a duel.", "Gain " + ::MSU.Text.colorPositive("+10%") + " chance to hit the challenged enemy and suffer " + ::MSU.Text.colorNegative("-20%") + " chance to hit every other opponent until either duelist dies or the challenged enemy's morale is broken.", "You can only duel one opponent at a time.", "Costs " + ::MSU.Text.colorNegative("2") + " [Action Points|Concept.ActionPoints] and builds " + ::MSU.Text.colorNegative("10") + " [Fatigue|Concept.Fatigue]."]],
		"perk.bh_punching_up": ["The bigger they are...", ["Deal " + ::MSU.Text.colorPositive("+15%") + " damage against enemies with more current [Hitpoints|Concept.Hitpoints] than you."]],
		"perk.bh_winner_takes_all": ["Don't dare steal my target.", ["After hitting an enemy, they become marked with Winner Takes All.", "Killing a marked enemy raises all your attributes and damage except Resolve and Hitpoints for the rest of the fight by " + ::MSU.Text.colorPositive("10%") + " of your Resolve. This effect stacks.", "If an ally kills one of your marked enemies, you trigger a negative morale check and lose all Winner Takes All stacks."]],
		"perk.bh_bloodied": ["Yes! YES!", ["The first time each [round|Concept.Round] that you or an adjacent enemy takes Hitpoint damage, recover " + ::MSU.Text.colorPositive("5") + " [Fatigue|Concept.Fatigue]."]],
		"perk.bh_relentless": ["Don't slow down!", ["Your [Initiative|Concept.Initiative] is reduced by only " + ::MSU.Text.colorPositive("50%") + " of your accumulated [Fatigue|Concept.Fatigue].", "Using the '[Wait|Concept.Wait]' command no longer gives you a penalty to [Initiative|Concept.Initiative] in the next round."]],
		"perk.bh_throwing_mastery": ["Master throwing weapons to wound or kill the enemy before they even get close.", ["Throwing skills build up " + ::MSU.Text.colorPositive("25%") + " less [Fatigue|Concept.Fatigue].", "Damage is increased by " + ::MSU.Text.colorPositive("20%") + " when attacking at " + ::MSU.Text.colorPositive("2") + " tiles of distance.", "Damage is increased by " + ::MSU.Text.colorPositive("15%") + " when attacking at " + ::MSU.Text.colorPositive("3") + " tiles of distance."]],
		"perk.bh_net_mastery": ["You mastered the art of pit fighting.", ["Throwing a net has a " + ::MSU.Text.colorPositive("{X}%") + " chance (10 + 50% of your Ranged Skill) to also net a random enemy adjacent to your target.", "Nets thrown by you are twice as difficult to escape from.", "When a net you threw is destroyed, the physical net is returned to your hand."]],
		"perk.bh_underdog": ["I'm used to it.", ["Any defense malus due to being surrounded by opponents no longer applies to this character.", "If an attacker has the Backstabber perk, it gives " + ::MSU.Text.colorNegative("+5%") + " instead of " + ::MSU.Text.colorNegative("+10%") + "."]],
		"perk.bh_all_eyes_on_me": ["Give them a show!", ["Deal " + ::MSU.Text.colorPositive("+5%") + " damage for each adjacent enemy beyond the first."]],
		"perk.bh_fast_adaptation": ["Adapt to your opponents' moves!", ["Gain an additional " + ::MSU.Text.colorPositive("+10%") + " chance to hit with each attack that misses an opponent.", "The bonus is reset upon landing a hit."]],
		"perk.bh_student": ["Everything can be learned if you put your mind into it.", ["Gain " + ::MSU.Text.colorPositive("20%") + " additional experience.", "Until reaching Level 11, participating in battles has a chance to permanently increase a random attribute by " + ::MSU.Text.colorPositive("1") + ".", "The harder the battle, the higher the chance, up to " + ::MSU.Text.colorPositive("50%") + ".", "At Level 11, gain an additional perk point."]],
		"perk.bh_gifted": ["Mercenary life comes easy when you are naturally gifted.", ["Instantly gain a level-up with maximum attribute rolls."]],
		"perk.bh_knowledge_mastery": ["Books are the truest art of them all.", ["Non-weapon skills cost " + ::MSU.Text.colorPositive("1") + " less [Action Point|Concept.ActionPoints], to a minimum of 1.", "Non-weapon skills build " + ::MSU.Text.colorPositive("25%") + " less [Fatigue|Concept.Fatigue]."]],
		"perk.bh_bullseye": ["Nailed it!", ["The penalty to hit chance when shooting at a target that has no clear line of fire is reduced from " + ::MSU.Text.colorNegative("75%") + " to " + ::MSU.Text.colorPositive("25%") + " for ranged weapons."]],
		"perk.bh_anticipation": ["I saw that coming!", ["Gain " + ::MSU.Text.colorPositive("+1") + " [Vision|Concept.Vision].", "When being attacked with ranged weapons, gain " + ::MSU.Text.colorPositive("1 + 10%") + " of your [base|Concept.BaseAttribute] [Ranged Defense|Concept.RangeDefense] as additional [Ranged Defense|Concept.RangeDefense] per tile that the attacker is away, and always at least " + ::MSU.Text.colorPositive("+10") + " [Ranged Defense|Concept.RangeDefense]."]],
		"perk.bh_bow_mastery": ["Master the art of archery and pelting your opponents with arrows.", ["Bow skills build up " + ::MSU.Text.colorPositive("25%") + " less [Fatigue|Concept.Fatigue].", ::MSU.Text.colorPositive("+1") + " [Vision|Concept.Vision].", ::MSU.Text.colorPositive("+1") + " Range with all bows."]],
		"perk.bh_crossbow_mastery": ["Master crossbows and learn to aim better.", ["Crossbow skills build up " + ::MSU.Text.colorPositive("25%") + " less [Fatigue|Concept.Fatigue].", "Crossbow reloading now requires " + ::MSU.Text.colorPositive("4") + " [Action Points|Concept.ActionPoints] to reload.", "An additional " + ::MSU.Text.colorPositive("20%") + " of damage inflicted with crossbows ignores armor."]],
		"perk.bh_eagle_eyesight": ["You can see far and strike near.", ["Gain " + ::MSU.Text.colorPositive("+1") + " [Vision|Concept.Vision].", "Bow and crossbow attacks deal " + ::MSU.Text.colorPositive("+5%") + " damage to armor for each point your Vision exceeds the distance to your target, up to " + ::MSU.Text.colorPositive("+25%") + ". Closer is better.", "This bonus does not apply against targets fewer than " + ::MSU.Text.colorNegative("3") + " tiles away."]],
		"perk.bh_quick_hands": ["Looking for this?", ["Swapping an item in battle becomes a free action with no Action Point cost once per turn.", "This does not work with shields.", "This does not work when swapping from one two-handed weapon to another two-handed weapon."]],
		"perk.bh_off_guard": ["You did not pay attention...", ["Gain " + ::MSU.Text.colorPositive("+10%") + " chance to hit enemies that have already acted this round."]],
		"perk.bh_patience": ["Wait.", ["Your next attack deals " + ::MSU.Text.colorPositive("+10%") + " damage for each non-damaging skill used earlier this turn.", "This bonus stacks."]],
		"perk.bh_gods_eyes": ["They are not really God's eyes, just really good ones.", ["Gain " + ::MSU.Text.colorPositive("+7") + " [Melee Defense|Concept.MeleeDefense] and [Ranged Defense|Concept.RangeDefense] for each point of [Vision|Concept.Vision] above " + ::MSU.Text.colorPositive("7") + "."]]
	};
	local d = data[_id];
	local type = _id == "perk.bh_duel_coward" ? ::UPD.EffectType.Active : ::UPD.EffectType.Passive;
	return ::Brotherhood.formatSurvivalPerkTooltip({ Fluff = d[0], Effects = [{ Type = type, Description = d[1] }] });
}

::Brotherhood.applySourcePerkIcon <- function( _skill, _sourceID, _fallback )
{
	if (::Brotherhood.applyCustomPerkIcon(_skill)) return;
	local source = ::Const.Perks.findById(_sourceID);
	_skill.m.Icon = source == null ? _fallback : source.Icon;
}

::Brotherhood.isWeaponSkillType <- function( _skill, _weaponType )
{
	if (_skill == null) return false;
	local item = _skill.getItem();
	return item != null && ("isItemType" in item) && item.isItemType(::Const.Items.ItemType.Weapon) && item.isWeaponType(_weaponType);
}

::Brotherhood.isNonWeaponSkill <- function( _skill )
{
	if (_skill == null || !_skill.isActive()) return false;
	local item = _skill.getItem();
	return item == null || !("isItemType" in item) || !item.isItemType(::Const.Items.ItemType.Weapon);
}

::Brotherhood.getNetMasteryChance <- function( _actor )
{
	return ::Math.min(100, 10 + ::Math.floor(_actor.getCurrentProperties().getRangedSkill() * 0.5));
}

::Brotherhood.registerExpansionArchetypePerks <- function()
{
	local defs = [
		["perk.bh_could_not_care_less", "Could Not Care Less", "perk.dodge"],
		["perk.bh_duel_coward", "Duel, Coward", "perk.taunt"],
		["perk.bh_punching_up", "Punching Up", "perk.executioner"],
		["perk.bh_winner_takes_all", "Winner Takes All", "perk.head_hunter"],
		["perk.bh_bloodied", "Bloodied", "perk.battle_flow"],
		["perk.bh_relentless", "Relentless", "perk.relentless"],
		["perk.bh_throwing_mastery", "Throwing Mastery", "perk.mastery.throwing"],
		["perk.bh_net_mastery", "Net Mastery", "perk.mastery.throwing"],
		["perk.bh_underdog", "Underdog", "perk.underdog"],
		["perk.bh_all_eyes_on_me", "All Eyes on Me", "perk.lone_wolf"],
		["perk.bh_fast_adaptation", "Fast Adaptation", "perk.fast_adaption"],
		["perk.bh_student", "Student", "perk.student"],
		["perk.bh_gifted", "Gifted", "perk.gifted"],
		["perk.bh_knowledge_mastery", "Knowledge Mastery", "perk.bags_and_belts"],
		["perk.bh_bullseye", "Bullseye", "perk.bullseye"],
		["perk.bh_anticipation", "Anticipation", "perk.anticipation"],
		["perk.bh_bow_mastery", "Bow Mastery", "perk.mastery.bow"],
		["perk.bh_crossbow_mastery", "Crossbow Mastery", "perk.mastery.crossbow"],
		["perk.bh_eagle_eyesight", "Eagle Eyesight", "perk.anticipation"],
		["perk.bh_quick_hands", "Quick Hands", "perk.quick_hands"],
		["perk.bh_off_guard", "Off Guard", "perk.overwhelm"],
		["perk.bh_patience", "Patience", "perk.berserk"],
		["perk.bh_gods_eyes", "God's Eyes", "perk.anticipation"]
	];
	local perks = [];
	foreach (d in defs)
	{
		local source = ::Const.Perks.findById(d[2]);
		local custom = ::Brotherhood.getCustomPerkIcons(d[0]);
		perks.push({
			ID = d[0],
			Script = "scripts/skills/perks/perk_" + d[0].slice(5),
			Name = d[1],
			Tooltip = ::Brotherhood.getExpansionArchetypeTooltip(d[0]),
			Icon = custom == null ? (source == null ? "ui/perks/perk_10.png" : source.Icon) : custom[0],
			IconDisabled = custom == null ? (source == null ? "ui/perks/perk_10_sw.png" : source.IconDisabled) : custom[1],
			PerkGroupIDs = []
		});
	}
	::DynamicPerks.Perks.addPerks(perks);
}

::Brotherhood.appendPerkGroupMembership <- function( _perkID, _groupID )
{
	local perk = ::Const.Perks.findById(_perkID);
	if (perk == null) return;
	if (!("PerkGroupIDs" in perk)) perk.PerkGroupIDs <- [];
	if (perk.PerkGroupIDs.find(_groupID) == null) perk.PerkGroupIDs.push(_groupID);
}

::Brotherhood.initializeExpansionArchetypes <- function()
{
	::Brotherhood.registerExpansionArchetypePerks();
	// Fleshcraft can roll these perks even when none of their native archetypes
	// are enabled. Their runtime hooks must therefore follow the perk pool too.
	if (!::Brotherhood.FleshcraftGenerationEnabled && !::Brotherhood.shouldInitializeArchetypeModule(["pg.bh_braggart", "pg.bh_gladiator", "pg.bh_prodigy", "pg.bh_marksman", "pg.bh_opportunist"])) return;

	::Brotherhood.HooksMod.hook("scripts/skills/skill", function(q) {
		q.use = @(__original) { function use( _targetTile, _free = false )
		{
			local container = this.getContainer();
			local patience = container == null ? null : container.getSkillByID("perk.bh_patience");
			local countForPatience = patience != null && !this.isAttack() && !_free;
			local ret = __original(_targetTile, _free);
			if (ret && countForPatience) patience.recordNonDamagingSkill(this);
			return ret;
		}}.use;

		q.getActionPointCost = @(__original) { function getActionPointCost()
		{
			local cost = __original();
			if (this.getContainer() != null && this.getContainer().hasSkill("perk.bh_knowledge_mastery") && ::Brotherhood.isNonWeaponSkill(this))
			{
				return ::Math.max(1, cost - 1);
			}
			return cost;
		}}.getActionPointCost;

		q.getFatigueCost = @(__original) { function getFatigueCost()
		{
			local cost = __original();
			if (this.getContainer() != null && this.getContainer().hasSkill("perk.bh_knowledge_mastery") && ::Brotherhood.isNonWeaponSkill(this))
			{
				return ::Math.max(0, ::Math.round(cost * 0.75));
			}
			return cost;
		}}.getFatigueCost;

		q.getTooltip = @(__original) { function getTooltip()
		{
			local ret = __original();
			if (this.getContainer() == null) return ret;
			if (::Brotherhood.isWeaponSkillType(this, ::Const.Items.WeaponType.Crossbow) && this.getContainer().hasSkill("perk.bh_crossbow_mastery"))
			{
				ret.push({ id = 94, type = "text", icon = "ui/icons/direct_damage.png", text = "Crossbow Mastery causes an additional " + ::MSU.Text.colorPositive("20%") + " of damage to ignore armor" });
			}
			if ((::Brotherhood.isWeaponSkillType(this, ::Const.Items.WeaponType.Bow) || ::Brotherhood.isWeaponSkillType(this, ::Const.Items.WeaponType.Crossbow)) && this.getContainer().hasSkill("perk.bh_eagle_eyesight"))
			{
				ret.push({ id = 95, type = "text", icon = "ui/icons/armor_damage.png", text = "Eagle Eyesight grants " + ::MSU.Text.colorPositive("+5%") + " armor damage per point of Vision above target distance, up to +25%, at ranges of 3 tiles or more" });
			}
			return ret;
		}}.getTooltip;
	});

	::Brotherhood.HooksMod.hook("scripts/skills/skill_container", function(q) {
		q.onDamageReceived = @(__original) { function onDamageReceived( _attacker, _damageHitpoints, _damageArmor )
		{
			__original(_attacker, _damageHitpoints, _damageArmor);
			if (_damageHitpoints <= 0) return;
			local damaged = this.getActor();
			if (damaged == null || !damaged.isPlacedOnMap()) return;
			local tile = damaged.getTile();
			for (local i = 0; i < 6; ++i)
			{
				if (!tile.hasNextTile(i)) continue;
				local next = tile.getNextTile(i);
				if (!next.IsOccupiedByActor) continue;
				local observer = next.getEntity();
				if (observer == null || observer.isAlliedWith(damaged)) continue;
				local bloodied = observer.getSkills().getSkillByID("perk.bh_bloodied");
				if (bloodied != null) bloodied.tryRecover("an adjacent enemy, " + damaged.getName() + ", took Hitpoint damage");
			}
		}}.onDamageReceived;
	});

	::Brotherhood.HooksMod.hook("scripts/items/item_container", function(q) {
		q.getActionCost = @(__original) { function getActionCost( _items )
		{
			local actor = this.getActor();
			if (::Brotherhood.isFreeLuteSwap(actor, _items)) return 0;
			local quick = actor == null ? null : actor.getSkills().getSkillByID("perk.bh_quick_hands");
			if (quick != null && quick.canUseFor(_items)) return 0;
			return __original(_items);
		}}.getActionCost;

		q.payForAction = @(__original) { function payForAction( _items )
		{
			local actor = this.getActor();
			local quick = actor == null ? null : actor.getSkills().getSkillByID("perk.bh_quick_hands");
			local spendsQuickHands = !::Brotherhood.isFreeLuteSwap(actor, _items) && quick != null && quick.canUseFor(_items);
			local ret = __original(_items);
			if (spendsQuickHands) quick.spend(_items);
			return ret;
		}}.payForAction;
	});

	::Brotherhood.HooksMod.hook("scripts/skills/actives/throw_net", function(q) {
		q.bhApplyNetMasteryNet <- function( _user, _target, _canReturnPhysicalNet )
		{
			if (_target == null || _target.getCurrentProperties().IsImmuneToRoot || _target.getCurrentProperties().IsRooted) return false;
			_target.getSkills().add(this.new("scripts/skills/effects/net_effect"));
			local breakFree = this.new("scripts/skills/actives/break_free_skill");
			breakFree.m.Icon = "skills/active_74.png";
			breakFree.m.IconDisabled = "skills/active_74_sw.png";
			breakFree.m.Overlay = "active_74";
			breakFree.m.SoundOnUse = this.m.SoundOnHitHitpoints;
			breakFree.setDecal(this.m.IsReinforced ? "net_destroyed_02" : "net_destroyed");
			breakFree.setChanceBonus(this.m.IsReinforced ? -15 : 0);
			_target.getSkills().add(breakFree);
			local marker = this.new("scripts/skills/effects/bh_net_mastery_effect");
			marker.setSource(_user.getID(), this.m.IsReinforced, _canReturnPhysicalNet);
			_target.getSkills().add(marker);
			local targetTile = _target.getTile();
			local effect = this.Tactical.spawnSpriteEffect(this.m.IsReinforced ? "bust_net_02" : "bust_net", this.createColor("#ffffff"), targetTile, 0, 10, 1.0, _target.getSprite("status_rooted").Scale, 100, 100, 0);
			effect.setHorizontalFlipping(!_target.isAlliedWithPlayer());
			this.Time.scheduleEvent(this.TimeUnit.Virtual, 200, this.onNetSpawn.bindenv(this), { TargetEntity = _target, IsReinforced = this.m.IsReinforced });
			return true;
		}

		q.getTooltip = @(__original) { function getTooltip()
		{
			local ret = __original();
			if (this.getContainer() == null || !this.getContainer().hasSkill("perk.bh_net_mastery")) return ret;
			local chance = ::Brotherhood.getNetMasteryChance(this.getContainer().getActor());
			ret.push({ id = 94, type = "text", icon = "ui/icons/ranged_skill.png", text = "Net Mastery has a " + ::MSU.Text.colorPositive(chance + "%") + " chance to also net a random enemy adjacent to the target" });
			ret.push({ id = 95, type = "text", icon = "ui/icons/special.png", text = "Nets thrown by this character are twice as difficult to escape from and return when destroyed" });
			return ret;
		}}.getTooltip;

		q.onUse = @(__original) { function onUse( _user, _targetTile )
		{
			local target = _targetTile.getEntity();
			local hasMastery = this.getContainer() != null && this.getContainer().hasSkill("perk.bh_net_mastery");
			local ret = __original(_user, _targetTile);
			if (!ret || !hasMastery || target == null || !target.getSkills().hasSkill("effects.net")) return ret;
			local primaryMarker = this.new("scripts/skills/effects/bh_net_mastery_effect");
			primaryMarker.setSource(_user.getID(), this.m.IsReinforced, true);
			target.getSkills().add(primaryMarker);
			local chance = ::Brotherhood.getNetMasteryChance(_user);
			local roll = ::Math.rand(1, 100);
			local candidates = [];
			for (local i = 0; i < 6; ++i)
			{
				if (!_targetTile.hasNextTile(i)) continue;
				local tile = _targetTile.getNextTile(i);
				if (!tile.IsOccupiedByActor) continue;
				local enemy = tile.getEntity();
				if (enemy == null || enemy.isAlliedWith(_user) || !enemy.isAlive() || enemy.getCurrentProperties().IsImmuneToRoot || enemy.getCurrentProperties().IsRooted) continue;
				candidates.push(enemy);
			}
			if (roll <= chance && candidates.len() != 0)
			{
				local extra = candidates[::Math.rand(0, candidates.len() - 1)];
				this.bhApplyNetMasteryNet(_user, extra, false);
				::Brotherhood.logArchetypeTest("NET MASTERY", _user, "Rolled " + roll + " against " + chance + "% and also netted " + extra.getName() + ".");
			}
			else
			{
				::Brotherhood.logArchetypeTest("NET MASTERY", _user, "Additional-net roll " + roll + " against " + chance + "% with " + candidates.len() + " eligible adjacent targets.");
			}
			return ret;
		}}.onUse;
	});

	::Brotherhood.HooksMod.hook("scripts/skills/actives/break_free_skill", function(q) {
		q.getChance = @(__original) { function getChance()
		{
			local chance = __original();
			if (this.getContainer() == null) return chance;
			if (this.getContainer().hasSkill("effects.bh_net_mastery")) chance = ::Math.floor(chance * 0.5);
			local actor = this.getContainer().getActor();
			if (actor != null && !actor.isAlliedWithPlayer() && actor.getMoraleState() == this.Const.MoraleState.Fleeing && this.getContainer().hasSkill("effects.net")) chance = ::Math.floor(chance * 0.5);
			return chance;
		}}.getChance;

		q.getTooltip = @(__original) { function getTooltip()
		{
			local ret = __original();
			if (this.getContainer() != null && this.getContainer().hasSkill("effects.bh_net_mastery"))
			{
				ret.push({ id = 8, type = "text", icon = "ui/tooltips/warning.png", text = "Net Mastery halves the chance to break free" });
			}
			if (this.getContainer() != null)
			{
				local actor = this.getContainer().getActor();
				if (actor != null && !actor.isAlliedWithPlayer() && actor.getMoraleState() == this.Const.MoraleState.Fleeing && this.getContainer().hasSkill("effects.net"))
				{
					ret.push({ id = 9, type = "text", icon = "ui/icons/morale.png", text = "Fleeing halves this enemy's chance to destroy the net" });
				}
			}
			return ret;
		}}.getTooltip;

		q.onUse = @(__original) { function onUse( _user, _targetTile )
		{
			local marker = this.getContainer() == null ? null : this.getContainer().getSkillByID("effects.bh_net_mastery");
			local ret = __original(_user, _targetTile);
			if (ret && marker != null) marker.onNetDestroyed("the target broke free");
			return ret;
		}}.onUse;
	});

	::Brotherhood.HooksMod.hook("scripts/entity/tactical/actor", function(q) {
		q.onDeath = @(__original) { function onDeath( _killer, _skill, _tile, _fatalityType )
		{
			foreach (mark in clone this.getSkills().m.Skills)
			{
				if (mark != null && !mark.isGarbage() && mark.getID() == "effects.bh_winner_takes_all_mark") mark.resolveDeath(_killer);
				else if (mark != null && !mark.isGarbage() && mark.getID() == "effects.bh_duel_mark") mark.resolveDeath();
				else if (mark != null && !mark.isGarbage() && mark.getID() == "effects.bh_net_mastery") mark.onNetDestroyed("the netted target died");
			}
			return __original(_killer, _skill, _tile, _fatalityType);
		}}.onDeath;
	});

	::Brotherhood.HooksMod.hook("scripts/entity/tactical/player", function(q) {
		q.updateLevel = @(__original) { function updateLevel()
		{
			local before = this.getLevel();
			local ret = __original();
			if (before < 11 && this.getLevel() >= 11)
			{
				local student = this.getSkills().getSkillByID("perk.bh_student");
				if (student != null) student.grantLevelElevenPerkPoint();
			}
			return ret;
		}}.updateLevel;
	});

	::Brotherhood.HooksMod.hook("scripts/ui/screens/tooltip/tooltip_events", function(q) {
		q.general_queryUIPerkTooltipData = @(__original) { function general_queryUIPerkTooltipData( _entityId, _perkId )
		{
			local ret = __original(_entityId, _perkId);
			if (ret == null) return ret;
			if (_perkId == "perk.bh_net_mastery")
			{
				local actor = ::Tactical.getEntityByID(_entityId);
				if (actor != null)
				{
					local chance = ::Brotherhood.getNetMasteryChance(actor);
					foreach (entry in ret)
					{
						if (!("text" in entry)) continue;
						local marker = entry.text.find("{X}");
						if (marker != null) entry.text = entry.text.slice(0, marker) + chance + entry.text.slice(marker + 3);
					}
				}
			}
			return ret;
		}}.general_queryUIPerkTooltipData;
	});

	local updateNativeMemberships = function()
	{
		if (!::Brotherhood.FleshcraftGenerationEnabled) return;
		::Brotherhood.appendPerkGroupMembership("perk.bh_anticipation", "pg.bh_marksman");
		::Brotherhood.appendPerkGroupMembership("perk.bags_and_belts", "pg.bh_opportunist");
	}
	::DynamicPerks.QueueBucket.AfterHooks.push(updateNativeMemberships);
	updateNativeMemberships();

	::Reforged.QueueBucket.AfterHooks.push(function() {
		if (!::Brotherhood.FleshcraftGenerationEnabled) return;
		local memberships = {
			"perk.bh_could_not_care_less": ["pg.bh_braggart"], "perk.bh_duel_coward": ["pg.bh_braggart"], "perk.bh_punching_up": ["pg.bh_braggart"], "perk.bh_winner_takes_all": ["pg.bh_braggart"],
			"perk.bh_bloodied": ["pg.bh_gladiator"], "perk.bh_relentless": ["pg.bh_gladiator"], "perk.bh_throwing_mastery": ["pg.bh_gladiator"], "perk.bh_net_mastery": ["pg.bh_gladiator"], "perk.bh_underdog": ["pg.bh_gladiator"], "perk.bh_all_eyes_on_me": ["pg.bh_gladiator"],
			"perk.bh_fast_adaptation": ["pg.bh_prodigy"], "perk.bh_student": ["pg.bh_prodigy"], "perk.bh_gifted": ["pg.bh_prodigy"], "perk.bh_knowledge_mastery": ["pg.bh_prodigy"],
			"perk.bh_bullseye": ["pg.bh_marksman"], "perk.bh_bow_mastery": ["pg.bh_marksman"], "perk.bh_crossbow_mastery": ["pg.bh_marksman"], "perk.bh_eagle_eyesight": ["pg.bh_marksman"],
			"perk.bh_quick_hands": ["pg.bh_opportunist"], "perk.bh_off_guard": ["pg.bh_opportunist"], "perk.bh_patience": ["pg.bh_opportunist"],
			"perk.bh_gods_eyes": ["pg.bh_duelist", "pg.bh_marksman"]
		};
		foreach (id, groups in memberships)
		{
			local perk = ::Const.Perks.findById(id);
			if (perk != null) perk.PerkGroupIDs = clone groups;
		}
		updateNativeMemberships();
		local category = ::DynamicPerks.PerkGroupCategories.findById("pgc.rf_fighting_style");
		if (category != null)
		{
			local groups = clone category.getGroups();
			foreach (id in ["pg.bh_braggart", "pg.bh_gladiator", "pg.bh_prodigy", "pg.bh_marksman", "pg.bh_opportunist"])
			{
				if (groups.find(id) == null) groups.push(id);
			}
			category.setGroups(groups);
		}
	});
}
